# PayTrack Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# Configurable MongoDB Connection URI (supports MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/paytrack

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Authentication JWT & Session Secret
JWT_SECRET=paytrack_super_secure_jwt_secret_key_change_in_production_998877
JWT_EXPIRES_IN=30d
SESSION_SECRET=paytrack_session_secret_ultra_safe_salt_key_112233
